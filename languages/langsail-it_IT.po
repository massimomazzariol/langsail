#. Plugin Name of the plugin
#: langsail.php
#: includes/abilities.php:26
#: includes/admin-settings.php:20
msgid "LangSail"
msgstr "LangSail"

#. Plugin URI of the plugin
#: langsail.php
msgid "https://github.com/massimomazzariol/langsail"
msgstr "https://github.com/massimomazzariol/langsail"

#. Description of the plugin
#: langsail.php
msgid "Cookie-free multilingual sites with one structure: pages are built once in the base language and every text is translated from a table."
msgstr "Siti multilingua senza cookie con una sola struttura: le pagine si costruiscono una volta nella lingua base e ogni testo si traduce da una tabella."

#. Author of the plugin
#: langsail.php
msgid "Massimo Mazzariol"
msgstr "Massimo Mazzariol"

#. Author URI of the plugin
#: langsail.php
msgid "https://github.com/massimomazzariol"
msgstr "https://github.com/massimomazzariol"

#: includes/abilities.php:27
msgid "Site translation: languages, texts to translate and translations."
msgstr "Traduzione del sito: lingue, testi da tradurre e traduzioni."

#: includes/abilities.php:54
msgid "Locale of a translation language, from langsail/list-languages."
msgstr "Locale di una lingua di traduzione, da langsail/list-languages."

#: includes/abilities.php:60
msgid "List languages"
msgstr "Elenca le lingue"

#: includes/abilities.php:61
msgid "Start here. Returns the site owner's instructions for translators (tone, audience, fixed terms: follow them in every translation), the base language, the texts that must never be translated, and the translation languages with their locale, URL prefix and progress."
msgstr "Inizia da qui. Restituisce le istruzioni del proprietario del sito per i traduttori (tono, pubblico, termini fissi: seguile in ogni traduzione), la lingua base, i testi da non tradurre mai e le lingue di traduzione con locale, prefisso dell'indirizzo e avanzamento."

#: includes/abilities.php:85
msgid "List texts to translate"
msgstr "Elenca i testi da tradurre"

#: includes/abilities.php:86
msgid "Lists texts of the site in the base language with their translation in one language. Markers like [1]...[/1] stand for links and formatting and [2/] for a line break: a translation must keep the same markers around the matching words. Kind \"attr\" and \"title\" are plain text. Follow the instructions from langsail/list-languages. Translate with langsail/save-translations."
msgstr "Elenca i testi del sito nella lingua base con la loro traduzione in una lingua. I segnaposto come [1]...[/1] indicano link e formattazione e [2/] un a capo: la traduzione deve tenere gli stessi segnaposto attorno alle parole corrispondenti. I tipi \"attr\" e \"title\" sono testo semplice. Segui le istruzioni di langsail/list-languages. Traduci con langsail/save-translations."

#: includes/abilities.php:96
msgid "missing: no translation yet; review: translation kept from an older version of the text, to check; all: every text."
msgstr "missing: ancora senza traduzione; review: traduzione ripresa da una versione precedente del testo, da controllare; all: tutti i testi."

#: includes/abilities.php:101
msgid "Only the texts of this page (its path, like /about/). Empty for every page."
msgstr "Solo i testi di questa pagina (il suo percorso, come /about/). Vuoto per tutte le pagine."

#: includes/abilities.php:150
#: includes/admin-strings.php:263
msgid "Save translations"
msgstr "Salva le traduzioni"

#: includes/abilities.php:151
msgid "Saves translations of texts from langsail/list-texts into one language. Each translation must keep the markers of its source. Translations with wrong markers are not saved and are returned as errors. Use status \"review\" to ask a person to check them."
msgstr "Salva le traduzioni dei testi di langsail/list-texts in una lingua. Ogni traduzione deve tenere i segnaposto dell'originale. Le traduzioni con segnaposto sbagliati non vengono salvate e tornano come errori. Usa lo stato \"review\" per chiedere a una persona di controllarle."

#: includes/abilities.php:199
msgid "Scan the site"
msgstr "Scansiona il sito"

#: includes/abilities.php:200
msgid "Visits every page of the site to collect new and changed texts. Run it after content changes, before listing the texts to translate. It can take a while on large sites."
msgstr "Visita ogni pagina del sito per raccogliere i testi nuovi e modificati. Eseguila dopo aver cambiato i contenuti, prima di elencare i testi da tradurre. Sui siti grandi può richiedere un po' di tempo."

#: includes/abilities.php:225
msgid "Not a translation language of this site. See langsail/list-languages."
msgstr "Non è una lingua di traduzione di questo sito. Vedi langsail/list-languages."

